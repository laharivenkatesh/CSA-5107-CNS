#include <stdio.h>
#include <stdint.h>

/* Left-shift and conditionally XOR for a 64-bit block */
uint64_t left_shift_64(uint64_t x)
{
    uint64_t msb = x & 0x8000000000000000ULL;

    x <<= 1;

    if (msb)
        x ^= 0x1B;       // Rb for 64-bit blocks

    return x;
}

/* Left-shift and conditionally XOR for a 128-bit block */
void left_shift_128(uint64_t in[2], uint64_t out[2])
{
    uint64_t msb = in[0] & 0x8000000000000000ULL;

    /* Shift the 128-bit value left by one bit */
    out[0] = (in[0] << 1) | (in[1] >> 63);
    out[1] = in[1] << 1;

    /* Rb = 0x87 for 128-bit blocks */
    if (msb)
        out[1] ^= 0x87;
}

void print128(uint64_t x[2])
{
    printf("%016llX%016llX\n",
           (unsigned long long)x[0],
           (unsigned long long)x[1]);
}

int main(void)
{
    /* L = E_K(0^n)
       In a real CMAC implementation, L is obtained
       by encrypting an all-zero block using AES/DES.
    */

    uint64_t L[2] = {
        0x8000000000000000ULL,
        0x0000000000000000ULL
    };

    uint64_t K1[2], K2[2];

    /* Generate K1 */
    left_shift_128(L, K1);

    /* Generate K2 */
    left_shift_128(K1, K2);

    printf("L  = ");
    print128(L);

    printf("K1 = ");
    print128(K1);

    printf("K2 = ");
    print128(K2);

    return 0;
}
