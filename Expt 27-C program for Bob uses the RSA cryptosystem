#include <stdio.h>

long long power_mod(long long a, long long e, long long n) {
    long long r = 1;

    while (e > 0) {
        if (e % 2)
            r = (r * a) % n;
        a = (a * a) % n;
        e /= 2;
    }
    return r;
}

int main() {
    long long e = 17;
    long long n = 3233;
    char text[] = "HELLO";

    printf("RSA Character Encryption\n");

    for (int i = 0; text[i] != '\0'; i++) {
        int m = text[i] - 'A';
        long long c = power_mod(m, e, n);

        printf("%c -> %lld\n", text[i], c);
    }

    printf("\nNot Secure: attacker can create a table\n");
    printf("for all 26 possible letters and match ciphertexts.\n");

    return 0;
}
