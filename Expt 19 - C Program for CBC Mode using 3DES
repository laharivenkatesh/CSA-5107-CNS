#include <stdio.h>
#include <string.h>

int main()
{
    char plain[] = "HELLO1234567890";
    char cipher[50];
    char key = 'K';
    char iv = 'I';
    int i;

    printf("Plain Text: %s\n", plain);

    for(i = 0; plain[i] != '\0'; i++)
    {
        cipher[i] = plain[i] ^ iv ^ key;
        iv = cipher[i];
    }

    cipher[i] = '\0';

    printf("Encrypted Text: ");

    for(i = 0; i < strlen(plain); i++)
        printf("%02X ", (unsigned char)cipher[i]);

    return 0;
}
