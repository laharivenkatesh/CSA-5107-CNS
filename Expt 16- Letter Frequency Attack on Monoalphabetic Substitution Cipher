#include <stdio.h>
#include <string.h>

int main()
{
    char c[100], p[100];
    char cipher[] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    char plain[]  = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    int i, j, n;

    printf("Enter Cipher Text: ");
    fgets(c, sizeof(c), stdin);

    printf("Enter number of possible plaintexts: ");
    scanf("%d", &n);

    printf("\nPossible Plaintexts:\n");

    for(j = 0; j < n; j++)
    {
        for(i = 0; c[i] != '\0'; i++)
        {
            if(c[i] >= 'A' && c[i] <= 'Z')
                p[i] = plain[c[i] - 'A'];
            else
                p[i] = c[i];
        }

        p[i] = '\0';

        printf("Plaintext %d: %s", j + 1, p);
    }

    return 0;
}
